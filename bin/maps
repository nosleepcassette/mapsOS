#!/usr/bin/env python3
# maps · cassette.help · MIT
"""
maps — standalone CLI for mapsOS life operating system.

Human-facing and agent-facing. Entries land in local SQLite by default, with
optional deferred flushes when an external backend is available.

Usage:
  maps vent "i'm exhausted and can't stop coding"
  maps flash "emma"               # sub-threshold phrase capture, no structure
  maps state thriving "context"
  maps body sleep none "up since 5am"
  maps mind flow high "6hr build session"
  maps spirit connection rising "good call with emma"
  maps intention water missed "forgot again"
  maps intention movement met "dog park 45min"
  maps check           # session start: pull context, check patterns
  maps pattern         # run pattern weaver on recent data
  maps review          # cycle review (last 14 days)
  maps survival        # check/display survival mode
  maps sync            # flush deferred local entries when available
  maps sync --status   # show how many entries are waiting
  maps tulpa           # multi-line stream capture (full tulpa protocol)
  maps eval            # show cassette's mapsOS performance trend
  maps person maggie   # show person context + recent interactions
"""
from __future__ import annotations

import argparse
import json
import sys
from collections import Counter
from datetime import date, datetime
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_REPO_ROOT))

from environments.maps_os_config import known_people, person_birth_hint, person_context
from environments.vent_parser import parse_vent, VALID_STATE_TAGS
from environments.pattern_weaver import weave
from environments.survival_mode import (
    evaluate as eval_survival,
    briefing as survival_briefing,
    filter_entries_for_survival,
)
from environments.local_store import (
    remember as resilient_remember,
    recall_resilient,
    sync_to_garden,
    count_pending,
    garden_available,
)
from environments.viz import render_trend, render_viz, render_trend_simple


def _today() -> str:
    return date.today().isoformat()


def _display_person_name(name: str) -> str:
    return "-".join(part.capitalize() for part in name.split("-"))


def _days_ago_text(value: date) -> str:
    days = (date.today() - value).days
    if days <= 0:
        return "today"
    if days == 1:
        return "1 day ago"
    return f"{days} days ago"


def _home_relative(path: Path) -> str:
    try:
        return str(path).replace(str(Path.home()), "~", 1)
    except Exception:
        return str(path)


def _astrolog_dir() -> Path:
    return Path.home() / ".hermes" / "astrolog"


def _astrolog_profile_path(name: str) -> Path:
    safe_name = name.lower().replace("-", "_")
    return _astrolog_dir() / f"{safe_name}_profile.json"


def _parse_person_entry(content: str) -> dict | None:
    if not content.startswith("PERSON:"):
        return None

    parts = [p.strip() for p in content.split("|")]
    if len(parts) < 4:
        return None

    date_str = parts[0].replace("PERSON:", "").strip()
    try:
        entry_date = datetime.strptime(date_str, "%Y-%m-%d").date()
    except Exception:
        return None

    return {
        "date": entry_date,
        "name": parts[1].lower(),
        "context": parts[2],
        "sentiment": parts[3].lower(),
    }


def _person_entries_by_name(entries: list[dict]) -> dict[str, list[dict]]:
    grouped: dict[str, list[dict]] = {}
    for entry in entries:
        parsed = _parse_person_entry(entry.get("content", ""))
        if not parsed:
            continue
        grouped.setdefault(parsed["name"], []).append(parsed)
    for name in grouped:
        grouped[name].sort(key=lambda item: item["date"], reverse=True)
    return grouped


def _build_astrolog_profile(name: str) -> tuple[dict, str]:
    context = person_context(name)
    birth_hint = person_birth_hint(name)
    birth_date = birth_hint.get("birth_date")
    birth_place = birth_hint.get("birth_place")
    comment = birth_hint.get("comment", "")

    profile = {
        "name": _display_person_name(name),
        "birth": {
            "date": birth_date or None,
            "time": None,
            "timezone": None,
            "fold": 0,
        },
        "location": {
            "place": birth_place or None,
            "latitude": None,
            "longitude": None,
        },
        "astrolog": {
            "zone": None,
            "daylight": "0",
            "binary": "/Users/maps/dev/astrolog/astrolog",
            "chart_file": None,
            "ephemeris_mode": "default",
        },
        "relationship": {
            "role": context.get("role") or "",
            "notes": context.get("notes") or "",
        },
        "birth_data_needed": not bool(birth_date),
        "updated_at": datetime.now().isoformat(timespec="seconds"),
    }

    if birth_date:
        notes = "birth date parsed from config comment"
        if birth_place:
            notes += "; place parsed from config comment"
        if comment and "uncertain" in comment.lower():
            notes += "; source comment marks location as uncertain"
        notes += "; birth time and astrolog-specific details may still be needed."
        profile["birth_notes"] = notes
        status = "birth date known"
    else:
        status = "birth data needed"

    return profile, status


def _remember(content: str, graph: str, dry_run: bool = False) -> str:
    """
    Write a single entry. Returns backend destination or 'dry'.
    Prints destination hint only when falling back to local.
    """
    if dry_run:
        print(f"  [dry] {content}")
        return "dry"
    _, dest = resilient_remember(content, graph=graph)
    if dest == "local":
        print("  (saved locally; remote backend unavailable)", file=sys.stderr)
    return dest


def _recall(prefix: str, graph: str, limit: int = 7) -> list[dict]:
    entries, _ = recall_resilient(prefix, graph=graph, limit=limit)
    return entries


def _parse_iso_date(value: str) -> date | None:
    try:
        return datetime.strptime(value, "%Y-%m-%d").date()
    except Exception:
        return None


def _reference_today(raw_date: str | None = None) -> date:
    return _parse_iso_date(raw_date or "") or date.today()


def _parse_win_entry(content: str) -> dict | None:
    if not content.startswith("WIN:"):
        return None

    parts = [p.strip() for p in content.split("|", 1)]
    if len(parts) < 2 or not parts[1]:
        return None

    entry_date = _parse_iso_date(parts[0].replace("WIN:", "").strip())
    if entry_date is None:
        return None

    return {"date": entry_date, "note": parts[1]}


def _group_wins_by_week(win_entries: list[dict]) -> list[tuple[tuple[int, int], list[dict]]]:
    grouped: dict[tuple[int, int], list[dict]] = {}
    for win in sorted(win_entries, key=lambda item: item["date"], reverse=True):
        iso = win["date"].isocalendar()
        key = (iso.year, iso.week)
        grouped.setdefault(key, []).append(win)
    return [(key, grouped[key]) for key in sorted(grouped, reverse=True)]


def _filter_entries_for_period(
    entries: list[dict],
    *,
    today: date,
    days: int | None = None,
    week: bool = False,
    month: bool = False,
) -> list[dict]:
    filtered: list[dict] = []
    current_iso = today.isocalendar()

    for entry in entries:
        entry_date = entry.get("date")
        if not isinstance(entry_date, date):
            continue
        if entry_date > today:
            continue
        if days is not None and (today - entry_date).days > days:
            continue
        if week:
            iso = entry_date.isocalendar()
            if (iso.year, iso.week) != (current_iso.year, current_iso.week):
                continue
        if month and (entry_date.year, entry_date.month) != (today.year, today.month):
            continue
        filtered.append(entry)

    return filtered


def _parse_goal_entry(content: str) -> dict | None:
    if not content.startswith("GOAL:"):
        return None

    parts = [p.strip() for p in content.split("|", 3)]
    if len(parts) < 4:
        return None

    entry_date = _parse_iso_date(parts[0].replace("GOAL:", "").strip())
    if entry_date is None:
        return None

    return {
        "date": entry_date,
        "description": parts[1],
        "due": parts[2],
        "status": parts[3].lower(),
    }


def _latest_goals(entries: list[dict]) -> list[dict]:
    latest: dict[str, dict] = {}
    for entry in entries:
        parsed = _parse_goal_entry(entry.get("content", ""))
        if not parsed:
            continue
        key = parsed["description"].lower()
        if key not in latest:
            latest[key] = parsed
    return list(latest.values())


def _parse_intention_entry(content: str) -> dict | None:
    if not content.startswith("INTENTION:"):
        return None

    parts = [p.strip() for p in content.split("|", 3)]
    if len(parts) < 3:
        return None

    entry_date = _parse_iso_date(parts[2])
    if entry_date is None:
        return None

    return {
        "name": parts[0].replace("INTENTION:", "").strip(),
        "status": parts[1].lower(),
        "date": entry_date,
        "note": parts[3] if len(parts) > 3 else "",
    }


def _parse_state_entry(content: str) -> dict | None:
    if not content.startswith("STATE:"):
        return None

    parts = [p.strip() for p in content.split("|", 2)]
    if len(parts) < 2:
        return None

    entry_date = _parse_iso_date(parts[0].replace("STATE:", "").strip())
    if entry_date is None:
        return None

    return {
        "date": entry_date,
        "tag": parts[1].lower(),
        "note": parts[2] if len(parts) > 2 else "",
    }


def _summarize_eval(
    intention_entries: list[dict],
    state_entries: list[dict],
    *,
    today: date,
    days: int = 30,
) -> dict:
    parsed_intentions = [
        parsed
        for parsed in (
            _parse_intention_entry(entry.get("content", "")) for entry in intention_entries
        )
        if parsed is not None
    ]
    parsed_states = [
        parsed
        for parsed in (_parse_state_entry(entry.get("content", "")) for entry in state_entries)
        if parsed is not None
    ]

    filtered_intentions = _filter_entries_for_period(parsed_intentions, today=today, days=days)
    filtered_states = _filter_entries_for_period(parsed_states, today=today, days=days)

    intention_counts = Counter(
        entry["status"]
        for entry in filtered_intentions
        if entry["status"] in ("met", "missed", "partial")
    )
    total_intentions = sum(intention_counts.values())
    weighted_met = intention_counts.get("met", 0) + (0.5 * intention_counts.get("partial", 0))
    met_rate = (weighted_met / total_intentions) if total_intentions else None
    state_counts = Counter(entry["tag"] for entry in filtered_states)

    return {
        "days": days,
        "intentions_total": total_intentions,
        "intention_counts": intention_counts,
        "met_rate": met_rate,
        "state_counts": state_counts,
        "arc_count": None,
    }


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_vent(args) -> int:
    text = " ".join(args.text)
    if not text.strip():
        print("usage: maps vent <text>", file=sys.stderr)
        return 1

    # Log raw text to eidetic before parsing (preserves original voice)
    _eidetic_log(text, source="maps-vent")

    entries = parse_vent(text, log_date=args.date or _today())

    # Survival mode filter
    if not args.no_survival_check:
        recent_states = _recall("STATE:", args.graph, limit=3)
        survival = eval_survival(recent_states)
        if survival.active:
            entries = filter_entries_for_survival(entries)
            print("survival mode — logging state/body only")

    for e in entries:
        content = e.to_garden()
        dest = _remember(content, graph=args.graph, dry_run=args.dry_run)
        if not args.dry_run:
            print(f"  {e.track}: {e.category} | {e.status or ''}")

    # Extract action items and route to nota (same path as tulpa)
    try:
        from environments.nota_bridge import extract_action_items, nota_available, route_vent_to_nota, nota_add
        if nota_available():
            actions = extract_action_items(text)
            if actions:
                print()
                if not args.dry_run:
                    routed = route_vent_to_nota(text)
                    if routed:
                        print(f"  {len(routed)} action item(s) → nota")
                        for a in routed:
                            print(f"    → {a}")
                else:
                    print(f"  {len(actions)} action item(s) detected (dry):")
                    for a in actions[:5]:
                        print(f"    [dry] → {a}")

            for e in entries:
                if e.track == "EVENT":
                    note = e.note
                    if "|" in note:
                        parts = note.split("|")
                        if len(parts) >= 2:
                            event_date = parts[0].strip()
                            desc = parts[1].strip()
                            try:
                                nota_add(desc, project="calendar", due=event_date)
                            except Exception:
                                pass
                elif e.track == "DEADLINE":
                    note = e.note
                    if "|" in note:
                        parts = note.split("|")
                        if len(parts) >= 2:
                            desc = parts[1].strip()
                            urgency = e.status or "medium"
                            try:
                                nota_add(desc, project="tasks", due=None, priority=urgency)
                            except Exception:
                                pass
    except Exception:
        pass

    # Pattern check after vent
    if not args.no_pattern and not args.dry_run:
        cmd_check(args, quiet=True)

    return 0


def cmd_flash(args) -> int:
    text = " ".join(args.text)
    if not text.strip():
        print("usage: maps flash <phrase>", file=sys.stderr)
        return 1
    content = f"FLASH: {args.date or _today()} | {text.strip()}"
    _remember(content, graph=args.graph, dry_run=args.dry_run)
    if not args.dry_run:
        print(f"  · {text.strip()}")
    return 0


def cmd_state(args) -> int:
    tag = args.tag.lower()
    if tag not in VALID_STATE_TAGS:
        print(f"unknown tag '{tag}'. valid: {', '.join(sorted(VALID_STATE_TAGS))}", file=sys.stderr)
        return 1
    narrative = " ".join(args.narrative) if args.narrative else ""
    content = f"STATE: {args.date or _today()} | {tag} | {narrative}"
    _remember(content, graph=args.graph, dry_run=args.dry_run)
    if not args.dry_run:
        print(f"  STATE: {tag}")
    return 0


def cmd_body(args) -> int:
    note = " ".join(args.note) if args.note else ""
    content = f"BODY: {args.date or _today()} | {args.category.lower()} | {args.status.lower()} | {note}"
    _remember(content, graph=args.graph, dry_run=args.dry_run)
    if not args.dry_run:
        print(f"  BODY: {args.category} | {args.status}")
    return 0


def cmd_mind(args) -> int:
    context = " ".join(args.context) if args.context else ""
    content = f"MIND: {args.date or _today()} | {args.category.lower()} | {args.status.lower()} | {context}"
    _remember(content, graph=args.graph, dry_run=args.dry_run)
    if not args.dry_run:
        print(f"  MIND: {args.category} | {args.status}")
    return 0


def cmd_spirit(args) -> int:
    note = " ".join(args.note) if args.note else ""
    content = f"SPIRIT: {args.date or _today()} | {args.category.lower()} | {args.status.lower()} | {note}"
    _remember(content, graph=args.graph, dry_run=args.dry_run)
    if not args.dry_run:
        print(f"  SPIRIT: {args.category} | {args.status}")
    return 0


def cmd_intention(args) -> int:
    status = args.status.lower()
    if status not in ("met", "missed", "partial"):
        print("status must be: met, missed, partial", file=sys.stderr)
        return 1
    note = " ".join(args.note) if args.note else ""
    content = f"INTENTION: {args.name.lower()} | {status} | {args.date or _today()} | {note}"
    _remember(content, graph=args.graph, dry_run=args.dry_run)
    if not args.dry_run:
        symbol = "✓" if status == "met" else ("~" if status == "partial" else "·")
        print(f"  {symbol} {args.name}: {status}")
    return 0


def _eidetic_log(text: str, source: str) -> None:
    """Write raw text to eidetic persistence layer if available."""
    try:
        import sys as _sys
        _repo = Path(__file__).resolve().parent.parent
        _eidetic_path = Path.home() / ".hermes" / "skills" / "eidetic-persistence"
        _sys.path.insert(0, str(_eidetic_path))
        from eidetic_logger import log_event
        log_event("user_input", text, metadata={"source": source, "system": "mapsOS"})
    except Exception:
        pass  # eidetic is optional — never block on its absence


def cmd_tulpa(args) -> int:
    """
    Multi-line stream capture mode — full tulpa protocol.
    Captures an unbounded thought stream, parses at the end.
    End with Ctrl+D or /done on its own line.
    """
    print("tulpa capture mode. I'm holding, not processing.")
    print("Continue until you're done. End with /done or Ctrl+D.")
    print()

    lines = []
    try:
        while True:
            try:
                line = input()
            except EOFError:
                break
            if line.strip().lower() in ("/done", "done"):
                break
            lines.append(line)
    except KeyboardInterrupt:
        print()

    text = "\n".join(lines).strip()
    if not text:
        print("nothing captured.")
        return 0

    # Log raw text to eidetic first (preserve original voice)
    _eidetic_log(text, source="maps-tulpa")

    # Parse and log structured entries
    entries = parse_vent(text, log_date=args.date or _today())

    if not args.no_survival_check:
        recent_states = _recall("STATE:", args.graph, limit=3)
        survival = eval_survival(recent_states)
        if survival.active:
            entries = filter_entries_for_survival(entries)
            print("survival mode — logging state/body only")

    print()
    for e in entries:
        content = e.to_garden()
        _remember(content, graph=args.graph, dry_run=args.dry_run)
        if not args.dry_run:
            print(f"  {e.track}: {e.category} | {e.status or ''}")

    # Extract action items if nota available
    try:
        from environments.nota_bridge import extract_action_items, nota_available
        if nota_available():
            actions = extract_action_items(text)
            if actions:
                print()
                print("  action items detected:")
                for a in actions[:5]:
                    print(f"  → {a}")
    except Exception:
        pass

    # Dominant theme summary
    if entries:
        state_entries = [e for e in entries if e.track == "STATE"]
        if state_entries:
            dominant = state_entries[0].category
            print()
            print(f"  dominant: {dominant}")

    # Pattern check
    if not args.no_pattern and not args.dry_run:
        cmd_check(args, quiet=True)

    return 0


def cmd_eval(args) -> int:
    """
    Show recent intention/state performance for cassette.
    """
    today = _reference_today(getattr(args, "date", None))
    days = args.days if getattr(args, "days", None) else 30

    intention_entries = _recall("INTENTION:", args.graph, limit=60)
    state_entries = _recall("STATE:", args.graph, limit=30)
    summary = _summarize_eval(
        intention_entries,
        state_entries,
        today=today,
        days=days,
    )

    met_rate = summary["met_rate"]
    if met_rate is None:
        met_rate_text = "n/a"
    else:
        met_rate_text = f"{met_rate * 100:.0f}%"

    try:
        from rich.console import Console
        from rich.table import Table

        console = Console()

        metrics = Table(title=f"maps eval — last {days} days")
        metrics.add_column("Metric")
        metrics.add_column("Value")
        metrics.add_row("Intentions logged", str(summary["intentions_total"]))
        metrics.add_row(
            "Intention met rate",
            (
                f"{met_rate_text}  "
                f"(met {summary['intention_counts'].get('met', 0)} / "
                f"partial {summary['intention_counts'].get('partial', 0)} / "
                f"missed {summary['intention_counts'].get('missed', 0)})"
            ),
        )
        arc_text = (
            str(summary["arc_count"])
            if summary["arc_count"] is not None
            else "arc history not persisted yet"
        )
        metrics.add_row("Arc fire count", arc_text)
        console.print(metrics)

        states = Table(title="STATE distribution")
        states.add_column("State")
        states.add_column("Count", justify="right")
        if summary["state_counts"]:
            for tag, count in sorted(
                summary["state_counts"].items(),
                key=lambda item: (-item[1], item[0]),
            ):
                states.add_row(tag, str(count))
        else:
            states.add_row("none", "0")
        console.print(states)
    except Exception:
        print(f"maps eval — last {days} days")
        print(f"intentions logged: {summary['intentions_total']}")
        print(
            "intention met rate: "
            f"{met_rate_text} "
            f"(met {summary['intention_counts'].get('met', 0)} / "
            f"partial {summary['intention_counts'].get('partial', 0)} / "
            f"missed {summary['intention_counts'].get('missed', 0)})"
        )
        if summary["state_counts"]:
            print("state distribution:")
            for tag, count in sorted(
                summary["state_counts"].items(),
                key=lambda item: (-item[1], item[0]),
            ):
                print(f"  {tag}: {count}")
        else:
            print("state distribution: none")
        print("arc fire count: arc history not persisted yet")
    return 0


def cmd_wins(args) -> int:
    """Show recent WIN entries grouped by ISO week."""
    today = _reference_today(getattr(args, "date", None))
    raw_entries = _recall("WIN:", args.graph, limit=50)
    parsed_wins = [
        parsed
        for parsed in (_parse_win_entry(entry.get("content", "")) for entry in raw_entries)
        if parsed is not None
    ]

    if args.week:
        wins = _filter_entries_for_period(parsed_wins, today=today, week=True)
    elif args.month:
        wins = _filter_entries_for_period(parsed_wins, today=today, month=True)
    else:
        wins = _filter_entries_for_period(parsed_wins, today=today, days=30)

    grouped = _group_wins_by_week(wins)
    if not grouped:
        print("no wins logged in this period.")
        return 0

    for index, ((year, week), entries) in enumerate(grouped):
        if index:
            print()
        print(f"week {week}, {year}")
        for entry in entries:
            print(f"  - {entry['date'].isoformat()}  {entry['note']}")
    return 0


def cmd_trend(args) -> int:
    """Show state trend chart."""
    days = args.days if hasattr(args, "days") else 90

    entries = _recall("STATE:", args.graph, limit=200)
    if not entries:
        print("no state data")
        return 0

    try:
        result = render_trend(entries, days=days)
        if result:
            from rich.console import Console
            console = Console()
            console.print(result)
            return 0
    except Exception:
        pass

    print(render_trend_simple(entries, days=days))
    return 0


def cmd_viz(args) -> int:
    """Show visualization dashboard."""
    body = _recall("BODY:", args.graph, limit=30)
    state = _recall("STATE:", args.graph, limit=30)

    try:
        result = render_viz(body, state, arc_history=None)
        if result:
            from rich.console import Console
            console = Console()
            console.print(result)
            return 0
    except Exception as e:
        print(f"viz not available: {e}", file=sys.stderr)

    print("Rich not available — install rich for viz")
    return 0


def cmd_connect(args) -> int:
    """Log connection with a person."""
    if args.status:
        entries = _recall("PERSON:", args.graph, limit=100)
        if not entries:
            print("no person connections logged")
            return 0

        people = known_people()
        seen: dict[str, str] = {}

        for e in entries:
            content = e.get("content", "")
            if content.startswith("PERSON:"):
                parts = content.split("|")
                if len(parts) >= 2:
                    note = parts[1].strip()
                    name = ""
                    if "|" in note:
                        name = note.split("|")[0].strip()
                    else:
                        name = note.strip()
                    if not name:
                        continue
                    date_part = parts[0].replace("PERSON:", "").strip()
                    seen[name.lower()] = date_part

        for person in sorted(seen):
            date_str = seen[person]
            print(f"{person}: last connection {date_str}")
        return 0

    name = args.person[0].lower() if args.person else ""
    if not name:
        print("usage: maps connect <person> [--note text]")
        return 1

    note = args.note[0] if args.note else "connected"

    content1 = f"SPIRIT: {_today()} | connection | rising | with {name}: {note}"
    content2 = f"PERSON: {_today()} | {name} | {note} | positive"

    _remember(content1, graph=args.graph, dry_run=args.dry_run)
    _remember(content2, graph=args.graph, dry_run=args.dry_run)

    if not args.dry_run:
        print(f"  connected with {name}")
    return 0


def cmd_person(args) -> int:
    """Show person context or initialize astrolog skeleton profiles."""
    if args.init_astrolog:
        astrolog_dir = _astrolog_dir()
        astrolog_dir.mkdir(parents=True, exist_ok=True)

        seen: set[str] = set()
        for name in known_people():
            if not name or name in seen:
                continue
            seen.add(name)

            context = person_context(name)
            alias_hint = " ".join(
                str(context.get(field, "")).lower() for field in ("role", "notes")
            )
            if "nickname for" in alias_hint:
                print(f"skipped: {_home_relative(_astrolog_profile_path(name))} [alias]")
                continue

            profile_path = _astrolog_profile_path(name)
            if profile_path.exists():
                print(f"skipped: {_home_relative(profile_path)} [exists]")
                continue

            profile, status = _build_astrolog_profile(name)
            if not args.dry_run:
                profile_path.write_text(
                    json.dumps(profile, indent=2) + "\n", encoding="utf-8"
                )
            print(f"created: {_home_relative(profile_path)} [{status}]")
        return 0

    person_entries = _recall("PERSON:", args.graph, limit=100)
    grouped_entries = _person_entries_by_name(person_entries)

    if args.list:
        ordered_names: list[str] = []
        seen = set()
        for person_name in known_people():
            if person_name and person_name not in seen:
                ordered_names.append(person_name)
                seen.add(person_name)
        for person_name in sorted(grouped_entries):
            if person_name not in seen:
                ordered_names.append(person_name)
                seen.add(person_name)

        if not ordered_names:
            print("no known people configured")
            return 0

        for person_name in ordered_names:
            context = person_context(person_name)
            role = context.get("role", "").strip()
            records = grouped_entries.get(person_name, [])
            if records:
                last_contact = records[0]["date"]
                contact_text = (
                    f"last contact {last_contact.isoformat()}  "
                    f"({_days_ago_text(last_contact)})"
                )
            else:
                contact_text = "no contacts logged"
            suffix = f"  {role}" if role else ""
            print(f"{person_name:<14} {contact_text}{suffix}")
        return 0

    name = (args.name[0] if args.name else "").lower().strip()
    if not name:
        print("usage: maps person <name> | maps person --list | maps person --init-astrolog")
        return 1

    context = person_context(name)
    role = context.get("role", "").strip()
    notes = context.get("notes", "").strip()
    records = grouped_entries.get(name, [])

    header = name
    if role:
        header = f"{header} — {role}"
    print(header)
    if notes:
        print(notes)
        print()

    if records:
        last_contact = records[0]["date"]
        print(f"last contact:  {last_contact.isoformat()}  ({_days_ago_text(last_contact)})")
        print(f"contacts logged: {len(records)}")
        print()
        print("recent interactions:")
        for record in records[:3]:
            print(
                f"  {record['date'].isoformat()}  {record['sentiment']:<8} {record['context']}"
            )
    else:
        print("last contact:  no contacts logged")
        print("contacts logged: 0")

    astrolog_path = _astrolog_profile_path(name)
    print()
    if astrolog_path.exists():
        print(f"astrolog: {_home_relative(astrolog_path)} ✓")
    else:
        print(f"astrolog: [no astrolog profile] {_home_relative(astrolog_path)}")

    # TODO: support `maps person <name> --birth "YYYY-MM-DD HH:MM City"` to
    # populate or upgrade astrolog profiles from new birth data.
    return 0


def cmd_goal(args) -> int:
    """Goal management."""
    if args.list:
        entries = _recall("GOAL:", args.graph, limit=50)
        if not entries:
            print("no open goals")
            return 0

        now = _reference_today(getattr(args, "date", None))
        goals = []

        for goal in _latest_goals(entries):
            if goal["status"] not in ("open", "in_progress"):
                continue
            days_open = max((now - goal["date"]).days, 0)
            goals.append((goal["description"], goal["due"], days_open))

        if not goals:
            print("no open goals")
            return 0

        for goal, due_str, days in sorted(goals, key=lambda x: x[2], reverse=True):
            due_str = due_str if due_str and due_str != "none" else "none"
            print(f"{goal}  [due: {due_str}]  ({days} days open)")
        return 0

    if args.done:
        phrase = args.done[0] if args.done else ""
        entries = _recall("GOAL:", args.graph, limit=50)
        matched = None

        for goal in _latest_goals(entries):
            if phrase.lower() in goal["description"].lower():
                matched = goal
                break

        if matched:
            content = (
                f"GOAL: {_today()} | {matched['description']} | "
                f"{matched['due']} | done"
            )
            _remember(content, graph=args.graph, dry_run=args.dry_run)
            if not args.dry_run:
                print(f"  goal marked done: {matched['description']}")
        else:
            print(f"  goal not found: {phrase}")
        return 0

    if getattr(args, "update", None):
        phrase = args.update[0] if args.update else ""
        entries = _recall("GOAL:", args.graph, limit=50)
        matched = None

        for goal in _latest_goals(entries):
            if phrase.lower() in goal["description"].lower():
                matched = goal
                break

        if matched:
            content = (
                f"GOAL: {_today()} | {matched['description']} | "
                f"{matched['due']} | in_progress"
            )
            _remember(content, graph=args.graph, dry_run=args.dry_run)
            if not args.dry_run:
                print("  ↻ goal updated: in_progress")
        else:
            print(f"  goal not found: {phrase}")
        return 0

    text = args.goal[0] if args.goal else ""
    if not text:
        print("usage: maps goal <text> [--due date]")
        return 1

    due = "none"
    if args.due:
        try:
            from environments.date_resolver import resolve_date
            due_date = resolve_date(args.due[0])
            if due_date:
                due = due_date.isoformat()
        except Exception:
            due = args.due[0]

    content = f"GOAL: {_today()} | {text} | {due} | open"
    _remember(content, graph=args.graph, dry_run=args.dry_run)
    if not args.dry_run:
        print(f"  goal added: {text}")
    return 0


def cmd_events(args) -> int:
    """Show upcoming events."""
    entries = _recall("EVENT:", args.graph, limit=30)
    if not entries:
        print("no upcoming events")
        return 0

    from datetime import datetime, timedelta
    today = datetime.now().date()
    events = []

    for e in entries:
        content = e.get("content", "")
        if not content.startswith("EVENT:"):
            continue
        parts = [p.strip() for p in content.split("|")]
        if len(parts) >= 3:
            date_str = parts[1]
            desc = " | ".join(parts[2:])
            try:
                event_date = datetime.strptime(date_str, "%Y-%m-%d").date()
                if event_date < today:
                    continue
                if args.week and event_date > today + timedelta(days=7):
                    continue
                events.append((event_date, desc))
            except Exception:
                pass

    if not events:
        print("no upcoming events")
        return 0

    for event_date, desc in sorted(events):
        print(f"{event_date.isoformat()}  {desc}")
    return 0


