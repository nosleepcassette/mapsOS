    "tulpa":     cmd_tulpa,
    "eval":      cmd_eval,
    "wins":      cmd_wins,
    "trend":     cmd_trend,
    "viz":       cmd_viz,
    "connect":  cmd_connect,
    "person":   cmd_person,
    "goal":    cmd_goal,
    "events":  cmd_events,
}


def main():
    parser = build_parser()
    args = parser.parse_args()

    if not args.command:
        if sys.stdin.isatty():
            try:
                from environments.tui import run as tui_run
                tui_run()
                return 0
            except Exception:
                pass
        return cmd_check(args)

    fn = COMMAND_MAP.get(args.command)
    if not fn:
        parser.print_help()
        return 1
    return fn(args)


if __name__ == "__main__":
    sys.exit(main())
