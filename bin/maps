def cmd_check(args, quiet: bool = False) -> int:
    state_entries     = _recall("STATE:",     args.graph, limit=7)
    body_entries      = _recall("BODY:",      args.graph, limit=7)
    mind_entries      = _recall("MIND:",      args.graph, limit=7)
    spirit_entries    = _recall("SPIRIT:",    args.graph, limit=7)
    intention_entries = _recall("INTENTION:", args.graph, limit=14)
    flash_entries     = _recall("FLASH:",     args.graph, limit=10)
    decision_entries  = _recall("DECISION:",  args.graph, limit=14)
    trigger_entries   = _recall("TRIGGER:",   args.graph, limit=14)
    goal_entries      = _recall("GOAL:",      args.graph, limit=21)
    person_entries    = _recall("PERSON:",    args.graph, limit=21)
    resistance_entries = _recall("RESISTANCE:", args.graph, limit=21)

    survival = eval_survival(state_entries)
    if survival.active:
        print(survival_briefing())
        return 0

    if not state_entries:
        if not quiet:
            print("No state logged recently. Vent or just drop a word?")
        return 0

    arcs = weave(
        state_entries,
        body_entries,
        mind_entries,
        spirit_entries,
        intention_entries,
        flash_entries=flash_entries,
        decision_entries=decision_entries,
        trigger_entries=trigger_entries,
        goal_entries=goal_entries,
        person_entries=person_entries,
        resistance_entries=resistance_entries,
    )

    if not quiet and state_entries:
        print(f"{_extract_tag(state_entries[-1])} lately.")

    alerts = [a for a in arcs if a.severity == "alert"]
    insights = [a for a in arcs if a.severity == "insight"]

    if alerts:
        print(f"→ {alerts[0].message}")
    elif insights and not quiet:
        print(f"→ {insights[0].message}")

    # Show pending local entries as quiet reminder
    n_pending = count_pending(graph=args.graph)
    if n_pending and not quiet:
        print(f"  ({n_pending} local entries waiting — run 'maps sync')", file=sys.stderr)

    # Role block — only if --role flag set
    if getattr(args, "role", False) and state_entries:
        state_tag = _extract_tag(state_entries[-1])
        role_data = _STATE_ROLE.get(state_tag)
        if role_data:
            primary, secondary, suspend, energy = role_data
            refs = _STATE_REFS.get(state_tag, [])
            print()
            print(f"ROLE  {state_tag} → {primary}  [{energy} energy]")
            if secondary:
                print(f"      secondary: {secondary}")
            if suspend:
                print(f"      suspend:   {', '.join(suspend)}")
            arc_hints = [
                _ARC_ROLE_HINTS[a.name]
                for a in arcs
                if a.name in _ARC_ROLE_HINTS
            ]
            for hint in arc_hints:
                print(f"      ARC {hint}")
            if refs:
                print(f"      refs: {', '.join(refs)}")
        else:
            print(f"\nROLE  no mapping for state '{state_tag}' — follow maps's lead")

    return 0


def cmd_pattern(args) -> int:
    state_entries      = _recall("STATE:",     args.graph, limit=14)
    state_entries_long = _recall("STATE:",     args.graph, limit=60)  # for cycle_meta
    body_entries       = _recall("BODY:",      args.graph, limit=14)
    mind_entries       = _recall("MIND:",      args.graph, limit=14)
    spirit_entries     = _recall("SPIRIT:",    args.graph, limit=14)
    intention_entries  = _recall("INTENTION:", args.graph, limit=21)
    flash_entries      = _recall("FLASH:",     args.graph, limit=10)
    decision_entries   = _recall("DECISION:",  args.graph, limit=21)
    trigger_entries    = _recall("TRIGGER:",   args.graph, limit=21)
    goal_entries       = _recall("GOAL:",      args.graph, limit=21)
    person_entries     = _recall("PERSON:",    args.graph, limit=21)
    resistance_entries = _recall("RESISTANCE:", args.graph, limit=21)

    arcs = weave(
        state_entries,
        body_entries,
        mind_entries,
        spirit_entries,
        intention_entries,
        flash_entries=flash_entries,
        decision_entries=decision_entries,
        trigger_entries=trigger_entries,
        goal_entries=goal_entries,
        person_entries=person_entries,
        resistance_entries=resistance_entries,
        state_entries_long=state_entries_long,
    )

    if not arcs:
        print("no patterns detected")
        return 0
    for arc in arcs:
        prefix = "!" if arc.severity == "alert" else "·"
        print(f"{prefix} [{arc.name}] {arc.message}")
    return 0


def cmd_review(args) -> int:
    state_entries     = _recall("STATE:",     args.graph, limit=14)
    body_entries      = _recall("BODY:",      args.graph, limit=14)
    spirit_entries    = _recall("SPIRIT:",    args.graph, limit=14)
    intention_entries = _recall("INTENTION:", args.graph, limit=14)

    if not state_entries:
        print("no state data to review")
        return 0

    tags = [_extract_tag(e) for e in state_entries]
    from collections import Counter
    dominant = Counter(tags).most_common(1)[0][0]
    met = sum(1 for e in intention_entries if _extract_status(e) == "met")
    missed = sum(1 for e in intention_entries if _extract_status(e) == "missed")

    print(f"Cycle: {tags[0]} → {tags[-1]}")
    print()
    print("What held:")
    print(f"→ {dominant} was the dominant state")
    if met or missed:
        print(f"→ intentions: {met} met, {missed} missed")
    print()
    print("What dropped:")
    all_entries = body_entries + spirit_entries
    absent = [t for t in ("connection", "movement", "sleep") if not _track_present(all_entries, t)]
    for item in absent:
        print(f"→ {item} was mostly absent")
    if not absent:
        print("→ no major absences detected")
    return 0


def cmd_survival(args) -> int:
    state_entries = _recall("STATE:", args.graph, limit=3)
    survival = eval_survival(state_entries)
    if survival.active:
        print(f"survival mode active ({survival.days_in_mode} days)")
        print()
        print(survival_briefing())
    else:
        tag = _extract_tag(state_entries[-1]) if state_entries else "unknown"
        print(f"survival mode inactive (last state: {tag})")
    return 0


def cmd_sync(args) -> int:
    n = count_pending(graph=args.graph)

    if args.status:
        if n == 0:
            print("local store: clean")
        else:
            print(f"local store: {n} entries pending sync")
            if not garden_available():
                print("  remote backend is currently unavailable")
        return 0

    if n == 0:
        print("nothing to sync")
        return 0

    if not garden_available():
        print(f"remote backend unavailable — {n} entries waiting")
        print("  try again when it is reachable")
        return 1

    result = sync_to_garden(graph=args.graph, dry_run=args.dry_run)
    if result.get("error"):
        print(f"sync failed: {result['error']}", file=sys.stderr)
        return 1
    print(f"synced {result['synced']} deferred entries")
    if result["failed"]:
        print(f"  {result['failed']} failed — will retry next sync")
    return 0


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _extract_tag(entry) -> str:
    if isinstance(entry, dict):
        content = entry.get("content", "")
        parts = [p.strip() for p in content.split("|")]
        return parts[1].lower() if len(parts) >= 2 else "unknown"
    return "unknown"


def _extract_status(entry) -> str:
    if isinstance(entry, dict):
        content = entry.get("content", "")
        parts = [p.strip() for p in content.split("|")]
        return parts[1].lower() if len(parts) >= 2 else ""
    return ""


def _track_present(entries: list, keyword: str) -> bool:
    return any(keyword in e.get("content", "").lower() for e in entries if isinstance(e, dict))


# ---------------------------------------------------------------------------
# Arg parser
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="maps",
        description="mapsOS — qualitative life operating system",
    )
    p.add_argument("--graph", default="cassette")
    p.add_argument("--date", default=None)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--no-pattern", action="store_true")
    p.add_argument("--no-survival-check", action="store_true")

    sub = p.add_subparsers(dest="command")

    v = sub.add_parser("vent",    help="free-form text → structured log")
    v.add_argument("text", nargs="+")

    fl = sub.add_parser("flash",  help="ultra-low friction phrase capture")
    fl.add_argument("text", nargs="+")

    st = sub.add_parser("state",  help="log STATE tag")
    st.add_argument("tag", help=f"one of: {', '.join(sorted(VALID_STATE_TAGS))}")
    st.add_argument("narrative", nargs="*")

    bo = sub.add_parser("body",   help="log BODY entry")
    bo.add_argument("category")
    bo.add_argument("status")
    bo.add_argument("note", nargs="*")

    mi = sub.add_parser("mind",   help="log MIND entry")
    mi.add_argument("category")
    mi.add_argument("status")
    mi.add_argument("context", nargs="*")

    sp = sub.add_parser("spirit", help="log SPIRIT entry")
    sp.add_argument("category")
    sp.add_argument("status")
    sp.add_argument("note", nargs="*")

    it = sub.add_parser("intention", help="log INTENTION (met/missed/partial)")
    it.add_argument("name")
    it.add_argument("status")
    it.add_argument("note", nargs="*")

    ch = sub.add_parser("check", help="session start context + pattern check")
    ch.add_argument("--role", action="store_true", help="output cassette role recommendation")
    sub.add_parser("pattern",  help="full pattern weaver output")
    sub.add_parser("review",   help="cycle review (14 days)")
    sub.add_parser("survival", help="check/display survival mode")

    sy = sub.add_parser("sync", help="flush deferred local entries")
    sy.add_argument("--status", action="store_true", help="show pending count only")

    sub.add_parser("tulpa",    help="multi-line stream capture (tulpa protocol)")

    evl = sub.add_parser("eval", help="show cassette mapsOS tracking summary")
    evl.add_argument("--days", type=int, default=30, help="number of days (default 30)")

    wi = sub.add_parser("wins", help="show recent wins grouped by week")
    win_scope = wi.add_mutually_exclusive_group()
    win_scope.add_argument("--week", action="store_true", help="this week only")
    win_scope.add_argument("--month", action="store_true", help="this month only")

    tr = sub.add_parser("trend",  help="show state trend chart")
    tr.add_argument("--days", type=int, default=90, help="number of days (default 90)")
    tr.add_argument("--full", action="store_true", help="show all-time")

    sub.add_parser("viz",    help="show visualization dashboard")

    co = sub.add_parser("connect", help="log connection with a person")
    co.add_argument("person", nargs="*", help="person name")
    co.add_argument("--note", nargs="*", help="note about the connection")
    co.add_argument("--status", action="store_true", help="show connection status")

    pe = sub.add_parser("person", help="show person context or init astrolog profiles")
    pe.add_argument("name", nargs="*", help="person name")
    pe.add_argument("--list", action="store_true", help="show known people + last contact")
    pe.add_argument(
        "--init-astrolog",
        action="store_true",
        help="create astrolog skeleton profiles for known people without one",
    )

    go = sub.add_parser("goal", help="manage goals")
    go.add_argument("goal", nargs="*", help="goal text")
    go.add_argument("--due", nargs="*", help="due date")
    go.add_argument("--list", action="store_true", help="list open goals")
    go.add_argument("--done", nargs="*", help="mark goal done")
    go.add_argument("--update", nargs="*", help="mark goal in progress")

    ev = sub.add_parser("events", help="show upcoming events")
    ev.add_argument("--week", action="store_true", help="this week only")

    return p


